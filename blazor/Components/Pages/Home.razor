@page "/"

<style>
    .home-container {
        padding: 40px 0;
        animation: fadeIn 0.5s ease-out;
    }

    .hero-section {
        text-align: center;
        margin-bottom: 50px;
    }

    .hero-title {
        font-size: 40px;
        font-weight: 700;
        color: var(--ios-black-text);
        margin-bottom: 10px;
        letter-spacing: -0.5px;
    }

    .hero-subtitle {
        font-size: 19px;
        color: var(--ios-gray-text);
        font-weight: 400;
    }

   
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 25px;
        max-width: 900px;
        margin: 0 auto;
    }

  
    .action-card {
        background-color: var(--ios-bg-card);
        border-radius: 22px; 
        padding: 30px 20px;
        box-shadow: var(--ios-shadow);
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
        
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        
        border: 1px solid rgba(0,0,0,0.02);
        
       
        text-decoration: none; 
        color: inherit; 
    }

    .action-card:hover {
        transform: translateY(-6px) scale(1.02);
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    }

    .card-icon-bg {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin-bottom: 20px;
    }

    .icon-new { background-color: #E8F5E9; color: var(--ios-tint); } 
    .icon-list { background-color: #E3F2FD; color: var(--ios-blue); } 
    .icon-stats { background-color: #FFF3E0; color: #FF9500; } 

    .card-title {
        font-size: 20px;
        font-weight: 600;
        color: var(--ios-black-text);
        margin-bottom: 8px;
    }

    .card-desc {
        font-size: 15px;
        color: var(--ios-gray-text);
        line-height: 1.4;
    }
</style>

<div class="home-container">
    <div class="hero-section">
        <div class="hero-title">Hola, bienvenido</div>
        <div class="hero-subtitle">Sistema de Facturación Taxi LM</div>
    </div>

    <div class="dashboard-grid">
        <a href="/Facturas" class="action-card">
            <div class="card-icon-bg icon-new">
                🚕
            </div>
            <div class="card-title">Crear Factura</div>
            <div class="card-desc">Registrar un nuevo viaje o generar una nota de cobro rápidamente.</div>
        </a>

        <a href="/ListaFacturas" class="action-card">
            <div class="card-icon-bg icon-list">
                📄
            </div>
            <div class="card-title">Historial</div>
            <div class="card-desc">Consultar facturas anteriores, editar detalles o reimprimir.</div>
        </a>

        <a href="/Reportes" class="action-card">
            <div class="card-icon-bg icon-stats">
                📈
            </div>
            <div class="card-title">Estadísticas</div>
            <div class="card-desc">Visualizar ingresos, gráficas de rendimiento y clientes VIP.</div>
        </a>
    </div>
</div>