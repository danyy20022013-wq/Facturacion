@page "/ListaFacturas"
@using facturas.Components.Data
@using FacturaModel = facturas.Components.Data.Facturas
@inject NavigationManager Navegacion
@inject ServicioFacturas ServicioFacturas
@rendermode InteractiveServer

<style>
    .ios-header-action {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    h1 {
        font-size: 34px;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .ios-btn-primary {
        background-color: var(--ios-tint);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        font-size: 15px;
    }

    .ios-search-bar {
        background-color: #E3E3E8;
        border-radius: 10px;
        padding: 8px 12px;
        border: none;
        width: 100%;
        font-size: 17px;
        margin-bottom: 20px;
        box-sizing: border-box;
    }

        .ios-search-bar:focus {
            outline: none;
            background-color: #D1D1D6;
        }

    .ios-list-group {
        background-color: var(--ios-bg-card);
        border-radius: var(--ios-radius);
        overflow: hidden;
        box-shadow: var(--ios-shadow);
    }

    .ios-list-item {
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 0.5px solid var(--ios-separator);
        cursor: pointer;
        background-color: white;
        transition: background-color 0.2s;
    }

        .ios-list-item:hover {
            background-color: #F2F2F7;
        }

    .item-main {
        display: flex;
        flex-direction: column;
    }

    .item-title {
        font-weight: 600;
        font-size: 17px;
        color: var(--ios-black-text);
    }

    .item-subtitle {
        font-size: 14px;
        color: var(--ios-gray-text);
        margin-top: 2px;
    }

    .item-trailing {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 17px;
    }

    .price-tag {
        color: var(--ios-black-text);
        font-weight: 500;
    }

    
    .btn-icon {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 18px;
        padding: 5px;
        border-radius: 50%;
        transition: background 0.2s;
    }

        .btn-icon:hover {
            background-color: rgba(0,0,0,0.05);
        }

    .btn-archivar {
        color: #FF9500;
    }

    .btn-desarchivar {
        color: var(--ios-tint);
    }

    .modo-secreto-bar {
        background-color: #333;
        color: white;
        padding: 10px 20px;
        border-radius: 10px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        animation: fadeIn 0.3s;
    }

    .input-secreto {
        background: #555;
        border: none;
        color: white;
        padding: 5px 10px;
        border-radius: 5px;
        outline: none;
    }
</style>

<div class="ios-header-action">
    <div style="display:flex; align-items:center; gap:10px;">
        <h1>@(modoArchivado ? "🗄️ Archivo Secreto" : "Facturas")</h1>

        <button class="btn-icon" style="font-size:22px;" @onclick="ToggleModoSecreto">
            @(modoArchivado ? "🔓" : "🔒")
        </button>
    </div>

    <button @onclick='() => Navegacion.NavigateTo("/Facturas")' class="ios-btn-primary">
        + Nueva
    </button>
</div>

@if (pidiendoPassword)
{
    <div class="modo-secreto-bar">
        <span>🔑 Ingrese contraseña:</span>
        <input type="password" @bind="passwordInput" class="input-secreto" @onkeyup="VerificarPassword" placeholder="****" />
        <button class="ios-btn-primary" style="padding: 4px 10px; font-size:13px;" @onclick="VerificarPasswordBtn">Entrar</button>
        <span style="color: #ff6b6b; margin-left:10px; font-size:13px;">@errorMsg</span>
    </div>
}

@if (!pidiendoPassword)
{
    <input type="text" @bind-value="filtroCliente" @oninput="FiltrarFacturas" placeholder="Buscar por cliente" class="ios-search-bar" />

    @if (facturasFiltradas == null)
    {
        <p style="text-align:center; color: var(--ios-gray-text);">Cargando...</p>
    }
    else if (facturasFiltradas.Count == 0)
    {
        <p style="text-align:center; color: var(--ios-gray-text); margin-top: 50px;">
            @(modoArchivado ? "No hay facturas archivadas." : "No hay facturas registradas.")
        </p>
    }
    else
    {
        <div class="ios-list-group">
            @foreach (var f in facturasFiltradas)
            {
                <div class="ios-list-item">
                    <div class="item-main" style="flex:1;" @onclick='() => Navegacion.NavigateTo($"/DetalleFactura/{f.Id}")'>
                        <span class="item-title">@f.Cliente</span>
                        <span class="item-subtitle">@f.Fecha.ToShortDateString()</span>
                    </div>

                    <div class="item-trailing">
                        <span class="price-tag" style="margin-right:15px;">@f.Total.ToString("C2")</span>

                        @if (modoArchivado)
                        {
                            <button class="btn-icon btn-desarchivar" title="Desarchivar" @onclick="() => AlternarArchivo(f)">
                                📤
                            </button>
                        }
                        else
                        {
                            <button class="btn-icon btn-archivar" title="Archivar" @onclick="() => AlternarArchivo(f)">
                                📥
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private List<FacturaModel> facturas;
    private List<FacturaModel> facturasFiltradas;
    private string filtroCliente = string.Empty;

    private bool modoArchivado = false;
    private bool pidiendoPassword = false;
    private string passwordInput = "";
    private string errorMsg = "";
    private const string PASSWORD_SECRETO = "taxi2024";

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        if (modoArchivado)
            facturas = await ServicioFacturas.ObtenerFacturasArchivadas();
        else
            facturas = await ServicioFacturas.ObtenerFacturas();

        AplicarFiltro();
    }

    private void ToggleModoSecreto()
    {
        if (modoArchivado)
        {
            modoArchivado = false;
            pidiendoPassword = false;
            passwordInput = "";
            CargarDatos();
        }
        else
        {
            pidiendoPassword = !pidiendoPassword;
            errorMsg = "";
            passwordInput = "";
        }
    }

    private void VerificarPassword(KeyboardEventArgs e) { if (e.Key == "Enter") VerificarPasswordBtn(); }

    private void VerificarPasswordBtn()
    {
        if (passwordInput == PASSWORD_SECRETO)
        {
            modoArchivado = true;
            pidiendoPassword = false;
            CargarDatos();
        }
        else
        {
            errorMsg = "Contraseña incorrecta";
        }
    }

    private async Task AlternarArchivo(FacturaModel f)
    {
        await ServicioFacturas.AlternarArchivo(f.Id, !modoArchivado);
        await CargarDatos();
    }

    private void FiltrarFacturas(ChangeEventArgs e)
    {
        filtroCliente = e.Value?.ToString() ?? string.Empty;
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        if (string.IsNullOrWhiteSpace(filtroCliente)) facturasFiltradas = facturas;
        else facturasFiltradas = facturas.Where(f => f.Cliente.Contains(filtroCliente, StringComparison.OrdinalIgnoreCase)).ToList();
    }
}