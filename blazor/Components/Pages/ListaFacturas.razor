@page "/ListaFacturas"
@using facturas.Components.Data
@using FacturaModel = facturas.Components.Data.Facturas
@inject NavigationManager Navegacion
@inject ServicioFacturas ServicioFacturas
@rendermode InteractiveServer

<style>
    
    .ios-header-action {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    h1 {
        font-size: 34px;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .ios-btn-primary {
        background-color: var(--ios-tint);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        font-size: 15px;
        transition: transform 0.1s;
    }

        .ios-btn-primary:active {
            transform: scale(0.96);
            opacity: 0.8;
        }

    
    .ios-search-bar {
        background-color: #E3E3E8;
        border-radius: 10px;
        padding: 8px 12px;
        border: none;
        width: 100%;
        font-size: 17px;
        margin-bottom: 20px;
        box-sizing: border-box; 
    }

        .ios-search-bar:focus {
            outline: none;
            background-color: #D1D1D6;
        }

    .ios-list-group {
        background-color: var(--ios-bg-card);
        border-radius: var(--ios-radius);
        overflow: hidden; 
    }

    
    .ios-list-item {
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 0.5px solid var(--ios-separator); 
        cursor: pointer;
        background-color: white;
        transition: background-color 0.2s;
    }

        .ios-list-item:last-child {
            border-bottom: none;
        }

        .ios-list-item:hover {
            background-color: #F2F2F7;
        }

    .item-main {
        display: flex;
        flex-direction: column;
    }

    .item-title {
        font-weight: 600;
        font-size: 17px;
        color: var(--ios-black-text);
    }

    .item-subtitle {
        font-size: 14px;
        color: var(--ios-gray-text);
        margin-top: 2px;
    }

    .item-trailing {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--ios-gray-text);
        font-size: 17px;
    }

    .price-tag {
        color: var(--ios-black-text);
        font-weight: 500;
    }

    .chevron {
        font-size: 14px;
        color: #C7C7CC;
    }
  
</style>

<div class="ios-header-action">
    <h1>Facturas</h1>
    <button @onclick='() => Navegacion.NavigateTo("/Facturas")' class="ios-btn-primary">
        + Nueva
    </button>
</div>

<input type="text"
       @bind-value="filtroCliente"
       @oninput="FiltrarFacturas"
       placeholder="Buscar por cliente"
       class="ios-search-bar" />

@if (facturasFiltradas == null)
{
    <p style="text-align:center; color: var(--ios-gray-text);">Cargando...</p>
}
else if (facturasFiltradas.Count == 0)
{
    <p style="text-align:center; color: var(--ios-gray-text); margin-top: 50px;">No hay facturas registradas.</p>
}
else
{
    <div class="ios-list-group">
        @foreach (var f in facturasFiltradas)
        {
            <div class="ios-list-item" @onclick='() => Navegacion.NavigateTo($"/DetalleFactura/{f.Id}")'>
                <div class="item-main">
                    <span class="item-title">@f.Cliente</span>
                    <span class="item-subtitle">@f.Fecha.ToShortDateString()</span>
                </div>
                <div class="item-trailing">
                    <span class="price-tag">@f.Total.ToString("C2")</span>
                    <span class="chevron">❯</span>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<FacturaModel> facturas;
    private List<FacturaModel> facturasFiltradas;
    private string filtroCliente = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        facturas = await ServicioFacturas.ObtenerFacturas();
        AplicarFiltro();
    }

    private void FiltrarFacturas(ChangeEventArgs e)
    {
        filtroCliente = e.Value?.ToString() ?? string.Empty;
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        if (string.IsNullOrWhiteSpace(filtroCliente)) facturasFiltradas = facturas;
        else facturasFiltradas = facturas.Where(f => f.Cliente.Contains(filtroCliente, StringComparison.OrdinalIgnoreCase)).ToList();
    }
}