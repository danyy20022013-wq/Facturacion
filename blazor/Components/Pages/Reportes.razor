@page "/Reportes"
@using facturas.Components.Data
@inject ServicioFacturas ServicioFacturas
@rendermode InteractiveServer

<style>
    h1 {
        font-size: 34px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .ios-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
    }

    .ios-widget {
        background-color: var(--ios-bg-card);
        border-radius: 20px; 
        padding: 20px;
        box-shadow: var(--ios-shadow);
        display: flex;
        flex-direction: column;
    }

    .widget-title {
        font-size: 15px;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--ios-gray-text);
        margin-bottom: 10px;
    }

    .widget-value-big {
        font-size: 36px;
        font-weight: 700;
        color: var(--ios-black-text);
    }

    .widget-list-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 0.5px solid var(--ios-separator);
        font-size: 15px;
    }

        .widget-list-item:last-child {
            border-bottom: none;
        }

    .text-green {
        color: var(--ios-tint);
        font-weight: 600;
    }
</style>

<h1>Estadísticas</h1>

@if (cargando)
{
    <p>Cargando...</p>
}
else
{
    <div class="ios-grid">

        <div class="ios-widget">
            <span class="widget-title">Ticket Promedio</span>
            <span class="widget-value-big">@ticketPromedio.ToString("C2")</span>
            <span style="font-size:13px; color:#8E8E93;">Por factura emitida</span>
        </div>

        <div class="ios-widget">
            <span class="widget-title">Ingresos por Tipo</span>
            @foreach (var d in ingresosPorTipo.Take(3))
            {
                <div class="widget-list-item">
                    <span>@d.Etiqueta</span>
                    <span class="text-green">@d.Valor.ToString("C2")</span>
                </div>
            }
        </div>

        <div class="ios-widget">
            <span class="widget-title">Top Clientes</span>
            @foreach (var d in mejoresClientes.Take(3))
            {
                <div class="widget-list-item">
                    <span>@d.Etiqueta</span>
                    <span>@d.Valor.ToString("C2")</span>
                </div>
            }
        </div>

        <div class="ios-widget">
            <span class="widget-title">Viajes Totales</span>
            @foreach (var d in volumenPorTipo.Take(3))
            {
                <div class="widget-list-item">
                    <span>@d.Etiqueta</span>
                    <span style="font-weight:bold;">@d.Valor.ToString("N0")</span>
                </div>
            }
        </div>

    </div>
}

@code {
    private bool cargando = true;
    private List<ReporteDato> ingresosPorTipo = new();
    private List<ReporteDato> mejoresClientes = new();
    private List<ReporteDato> ventasPorMes = new();
    private List<ReporteDato> volumenPorTipo = new();
    private decimal ticketPromedio = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var t1 = ServicioFacturas.ObtenerIngresosPorTipo();
            var t2 = ServicioFacturas.ObtenerMejoresClientes();
            var t3 = ServicioFacturas.ObtenerVentasPorMes();
            var t4 = ServicioFacturas.ObtenerVolumenPorTipo();
            var t5 = ServicioFacturas.ObtenerTicketPromedio();
            await Task.WhenAll(t1, t2, t3, t4, t5);
            ingresosPorTipo = t1.Result; mejoresClientes = t2.Result; ventasPorMes = t3.Result; volumenPorTipo = t4.Result; ticketPromedio = t5.Result;
        }
        catch { }
        cargando = false;
    }
}