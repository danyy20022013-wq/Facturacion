@page "/DetalleFactura/{FacturaId:int}"
@using facturas.Components.Data
@using FacturaModel = facturas.Components.Data.Facturas
@inject NavigationManager Navegacion
@inject ServicioFacturas ServicioFacturas
@rendermode InteractiveServer

<style>
    .ios-detail-card {
        background-color: var(--ios-bg-card);
        border-radius: var(--ios-radius);
        padding: 20px;
        margin-top: 20px;
        box-shadow: var(--ios-shadow);
    }

    .detail-header {
        border-bottom: 0.5px solid var(--ios-separator);
        padding-bottom: 15px;
        margin-bottom: 15px;
    }

    .client-name {
        font-size: 24px;
        font-weight: 700;
    }

    .invoice-date {
        color: var(--ios-gray-text);
        font-size: 15px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 0.5px solid #F2F2F7;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .total-row {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
        font-size: 20px;
        font-weight: 700;
    }

    .ios-btn-text {
        color: var(--ios-blue);
        background: none;
        border: none;
        font-size: 17px;
        cursor: pointer;
    }

    .ios-btn-danger {
        color: var(--ios-red);
        background: none;
        border: none;
        font-size: 17px;
        cursor: pointer;
    }
</style>

@if (factura != null)
{
    <div style="display:flex; justify-content:space-between; align-items:center;">
        <button class="ios-btn-text" @onclick='() => Navegacion.NavigateTo("/ListaFacturas")'>❮ Atrás</button>
        <button class="ios-btn-text" @onclick='() => Navegacion.NavigateTo($"/Factura/{factura.Id}")'>Editar</button>
    </div>

    <div class="ios-detail-card">
        <div class="detail-header">
            <div class="client-name">@factura.Cliente</div>
            <div class="invoice-date">@factura.Fecha.ToLongDateString()</div>
        </div>

        @foreach (var v in factura.Viajes)
        {
            <div class="detail-row">
                <div style="display:flex; flex-direction:column;">
                    <span style="font-weight:500;">@v.Descripcion</span>
                    <span style="font-size:13px; color:#8E8E93;">@v.Tipo • @v.Folio</span>
                </div>
                <span>@v.Monto.ToString("C2")</span>
            </div>
        }

        <div class="total-row">
            <span>Total</span>
            <span>@factura.Total.ToString("C2")</span>
        </div>
    </div>

    <div style="text-align:center; margin-top: 30px;">
        <button class="ios-btn-danger" @onclick="Eliminar">Eliminar Factura</button>
    </div>
}
else
{

    <p>Cargando...</p>
}

@code {
    [Parameter] public int FacturaId { get; set; }
    private FacturaModel factura;
    protected override async Task OnInitializedAsync() => factura = await ServicioFacturas.ObtenerFacturaPorId(FacturaId);

    private async Task Eliminar()
    {
        await ServicioFacturas.EliminarFactura(factura);
        Navegacion.NavigateTo("/ListaFacturas");
    }
}