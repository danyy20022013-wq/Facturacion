@page "/Facturas"
@page "/Factura/{Id:int}"
@using facturas.Components.Data
@using FacturaModel = facturas.Components.Data.Facturas
@using ViajeModel = facturas.Components.Data.Viaje
@inject ServicioFacturas ServicioFacturas
@inject NavigationManager Navegacion
@rendermode InteractiveServer

<style>
    h2 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    
    .ios-form-section {
        background-color: var(--ios-bg-card);
        border-radius: var(--ios-radius);
        margin-bottom: 25px;
        overflow: hidden;
    }

    .ios-input-row {
        display: flex;
        align-items: center;
        padding: 12px 20px;
        border-bottom: 0.5px solid var(--ios-separator);
        background: white;
    }

        .ios-input-row:last-child {
            border-bottom: none;
        }

    .ios-label {
        width: 100px; 
        font-size: 17px;
        color: var(--ios-black-text);
    }

    .ios-input {
        flex: 1; 
        border: none;
        font-size: 17px;
        color: var(--ios-blue); 
        outline: none;
        background: transparent;
        text-align: right; 
    }

        .ios-input::placeholder {
            color: #C7C7CC;
        }

    .ios-section-header {
        text-transform: uppercase;
        font-size: 13px;
        color: var(--ios-gray-text);
        margin: 0 0 8px 20px;
    }

    
    .ios-action-btn {
        width: 100%;
        padding: 14px;
        background-color: var(--ios-tint);
        color: white;
        border: none;
        border-radius: var(--ios-radius);
        font-size: 17px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 10px;
    }

    .ios-btn-secondary {
        background-color: transparent;
        color: var(--ios-red);
        margin-top: 10px;
    }

 
    .travel-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 20px;
        border-bottom: 0.5px solid var(--ios-separator);
    }

    .travel-info {
        display: flex;
        flex-direction: column;
    }

    .travel-desc {
        font-weight: 500;
        font-size: 16px;
    }

    .travel-meta {
        font-size: 13px;
        color: var(--ios-gray-text);
    }

    .travel-price {
        color: var(--ios-black-text);
        font-weight: 600;
    }

    
    .btn-delete-small {
        background: var(--ios-red);
        color: white;
        border: none;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        font-weight: bold;
        margin-left: 10px;
        cursor: pointer;
    }
</style>

<h2>@(Id.HasValue ? "Editar Factura" : "Nueva Factura")</h2>

<div class="ios-section-header">DATOS GENERALES</div>
<div class="ios-form-section">
    <div class="ios-input-row">
        <span class="ios-label">Fecha</span>
        <input type="date" @bind="facturaActual.Fecha" class="ios-input" />
    </div>
    <div class="ios-input-row">
        <span class="ios-label">Cliente</span>
        <input @bind="facturaActual.Cliente" placeholder="Nombre completo" class="ios-input" />
    </div>
</div>

<div class="ios-section-header">VIAJES</div>
<div class="ios-form-section">
    @if (viajesTemp.Count > 0)
    {
        @foreach (var v in viajesTemp)
        {
            <div class="travel-row">
                <div class="travel-info">
                    <span class="travel-desc">@v.Descripcion</span>
                    <span class="travel-meta">@v.Tipo • Folio: @v.Folio</span>
                </div>
                <div style="display:flex; align-items:center;">
                    <span class="travel-price">@v.Monto.ToString("C2")</span>
                    <button class="btn-delete-small" @onclick="() => EliminarViajeTemp(v)">-</button>
                </div>
            </div>
        }
        <div class="ios-input-row" style="background-color: #FAFAFA;">
            <span class="ios-label" style="font-weight:bold;">Total</span>
            <span class="ios-input" style="color: black; font-weight:bold;">@viajesTemp.Sum(x => x.Monto).ToString("C2")</span>
        </div>
    }
    else
    {
        <div class="ios-input-row" style="justify-content:center; color:var(--ios-gray-text);">
            No hay viajes agregados
        </div>
    }
</div>

<div class="ios-section-header">AGREGAR VIAJE</div>
<div class="ios-form-section">
    <div class="ios-input-row">
        <span class="ios-label">Tipo</span>
        <select @bind="nuevoViaje.Tipo" class="ios-input" style="direction: rtl;">
            <option value="Local">Local</option>
            <option value="Foraneo">Foráneo</option>
            <option value="Compra">Compras</option>
        </select>
    </div>
    <div class="ios-input-row">
        <span class="ios-label">Desc.</span>
        <input @bind="nuevoViaje.Descripcion" placeholder="Ej. Centro a Aeropuerto" class="ios-input" />
    </div>
    <div class="ios-input-row">
        <span class="ios-label">Folio</span>
        <input @bind="nuevoViaje.Folio" placeholder="0001" class="ios-input" />
    </div>
    <div class="ios-input-row">
        <span class="ios-label">Monto</span>
        <input type="number" @bind="nuevoViaje.Monto" placeholder="$0.00" class="ios-input" />
    </div>

    <button class="ios-action-btn" style="border-radius:0; margin:0;" @onclick="AgregarViajeTemp">
        + Agregar a la lista
    </button>
</div>

<button @onclick="GuardarFactura" class="ios-action-btn">
    @(Id.HasValue ? "Guardar Cambios" : "Crear Factura")
</button>

<div style="text-align: center;">
    <button @onclick='() => Navegacion.NavigateTo("/ListaFacturas")' class="ios-action-btn ios-btn-secondary">
        Cancelar
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(mensajeError))
{
    <p style="color: var(--ios-red); text-align: center; margin-top: 15px;">@mensajeError</p>
}

@code {
    [Parameter] public int? Id { get; set; }
    private FacturaModel facturaActual = new() { Fecha = DateTime.Now.Date };
    private ViajeModel nuevoViaje = new() { Tipo = "Local" };
    private List<ViajeModel> viajesTemp = new();
    private string mensajeError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            var f = await ServicioFacturas.ObtenerFacturaPorId(Id.Value);
            if (f != null) { facturaActual = f; viajesTemp = new List<ViajeModel>(f.Viajes); }
        }
    }

    private void AgregarViajeTemp()
    {
        if (nuevoViaje.Monto <= 0) return;
        viajesTemp.Add(new ViajeModel { Tipo = nuevoViaje.Tipo, Descripcion = nuevoViaje.Descripcion, Folio = nuevoViaje.Folio, Monto = nuevoViaje.Monto });
        string prevType = nuevoViaje.Tipo;
        nuevoViaje = new ViajeModel { Tipo = prevType };
    }

    private void EliminarViajeTemp(ViajeModel v) => viajesTemp.Remove(v);

    private async Task GuardarFactura()
    {
        if (viajesTemp.Count == 0 || string.IsNullOrWhiteSpace(facturaActual.Cliente)) { mensajeError = "Faltan datos"; return; }
        facturaActual.Viajes = new List<ViajeModel>(viajesTemp);
        if (Id.HasValue) await ServicioFacturas.ActualizarFactura(facturaActual);
        else await ServicioFacturas.AgregarFactura(facturaActual);
        Navegacion.NavigateTo("/ListaFacturas");
    }
}